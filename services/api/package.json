{
  "name": "@itsm/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "pnpm build && concurrently -k \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "pnpm build && node dist/infrastructure/db/migrate.js",
    "db:studio": "drizzle-kit studio",
    "test:int": "vitest run -c vitest.int.config.ts",
    "db:seed": "pnpm build && node dist/infrastructure/db/seed/seed.js"
  },
  "dependencies": {
    "@itsm/contracts": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.4",
    "jose": "6.2.15",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.21",
    "@testcontainers/postgresql": "12.2.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.1",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
