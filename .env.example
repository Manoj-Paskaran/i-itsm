# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
DATABASE_URL=postgresql://itsm:itsm@localhost:5432/itsm
# Required in production (>= 32 chars); development/test fall back to a built-in dev secret.
# JWT_SECRET=<at least 32 random characters>
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=20
ML_SERVICE_URL=http://localhost:8001
VALKEY_URL=redis://localhost:6379
SMTP_URL=smtp://localhost:1025
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# SLA risk serving engine: rules (default) or model
SLA_RISK_ENGINE=rules
