# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
DATABASE_URL=postgresql://itsm:itsm@localhost:5432/itsm
# Required in production (>= 32 chars); development/test fall back to a built-in dev secret.
# JWT_SECRET=<at least 32 random characters>
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800
# Optional Google sign-in: enable with both client ID and secret from a Web application OAuth client.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=20
ML_SERVICE_URL=http://localhost:8001
CHAT_INTAKE_TIMEOUT_MS=15000
CHAT_INTAKE_REPLAY_MS=1200
# ML-side Gemini budget for the chat's first message; keep it below CHAT_INTAKE_TIMEOUT_MS.
CHAT_INTAKE_TIMEOUT_SECONDS=10
# false skips the seeded demo readings (fixtures/chat_intake_cache.json) to try a live Gemini call.
CHAT_INTAKE_USE_FIXTURE=true
VALKEY_URL=redis://localhost:6379
SMTP_URL=smtp://localhost:1025
# Real email (optional). Gmail: Google Account -> Security -> 2-Step Verification -> App passwords.
# Create an app password, then set the lines below in .env (never commit them).
# The user part is the full Gmail address with @ encoded as %40; drop the spaces from the app password.
# SMTP_URL=smtps://your-gmail%40gmail.com:app-password@smtp.gmail.com:465
# Gmail requires the sender to be the authenticated account.
# MAIL_FROM="I-ITSM <your-gmail@gmail.com>"
# Always set an allowlist with a real SMTP server, so seeded incidents email nobody else.
# EMAIL_ALLOWLIST=you@example.com
# Gives one seeded user a real address (re-seed after setting). Priya then gets real
# "information requested" / "incident resolved" emails, and Google sign-in with that address lands as Priya.
# DEMO_EMAIL_OVERRIDE=priya@itsm.demo=you@example.com
# Must be true for email (the default outside tests).
# NOTIFICATIONS_EMAIL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# SLA risk serving engine: rules (default) or model
SLA_RISK_ENGINE=rules
